    {
      "id": "DsjhkeVHGQB2W5kfLIXNT",
      "type": "text",
      "x": 1637.6721802670625,
      "y": 308.47681095471364,
      "width": 158.33990478515625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ag",
      "roundness": null,
