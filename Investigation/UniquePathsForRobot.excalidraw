      "seed": 2075274618,
      "version": 208,
      "versionNonce": 1309097210,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793447541033,
      "created": 1793447383781,
      "link": null,
      "locked": false,
      "text": "1) paths(n,m) = paths(n-1,m) + paths(n, m - 1)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) paths(n,m) = paths(n-1,m) + paths(n, m - 1)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "dciOFIq-aWHRHQUwUvWQc",
      "type": "text",
      "x": 1634.999626856083,
      "y": 269.05664814275985,
      "width": 299.7598571777344,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
