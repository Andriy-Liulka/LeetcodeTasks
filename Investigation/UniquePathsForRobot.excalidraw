      "groupIds": [],
      "frameId": null,
      "index": "af",
      "roundness": null,
      "seed": 1430181562,
      "version": 276,
      "versionNonce": 229480038,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793447594360,
      "created": 1793447472682,
      "link": null,
      "locked": false,
      "text": "2) paths(x,0) = paths(0,x) = 0",
      "fontSize": 20,
      "baseFontSize": null,
